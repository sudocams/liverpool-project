PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Bump this when the participant information and consent wording changes.
STUDY_INFO_VERSION=draft-5
# 0 disables automatic cleanup. Set a positive day count to enable daily pruning.
DATA_RETENTION_DAYS=0
# Maximum assessment submissions per phase, including the first attempt.
ASSESSMENT_MAX_ATTEMPTS=3
# Delayed retention quiz unlocks this many days after the learner's post-test (minimum 14).
RETENTION_TEST_DELAY_DAYS=21
# Use a private random value of at least 32 characters. Required in production.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Set once to create the first admin account, then remove it from the environment.
# ADMIN_BOOTSTRAP_KEY=
# Optional. Uncomment when a local MongoDB server is available.
# MONGODB_URI=mongodb://127.0.0.1:27017/cyberwolf
# Optional. AI feedback uses the guided fallback when no key is configured.
# Review provider privacy, retention, and licensing before enabling for research.
# AI_API_KEY=
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini
